{
  "name": "masri-m-syariah-v1.0---e-commerce",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "pnpm --filter masrim-server dev",
    "dev:all": "concurrently -k -n web,api -c green,cyan \"vite\" \"pnpm --filter masrim-server dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && pnpm --filter masrim-server typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter masrim-server db:generate",
    "db:migrate": "pnpm --filter masrim-server db:migrate",
    "db:seed": "pnpm --filter masrim-server db:seed",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:seed-demo": "pnpm --filter masrim-server db:seed-demo",
    "db:seed-asia": "pnpm --filter masrim-server db:seed-asia",
    "test": "pnpm --filter masrim-server test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "packageManager": "pnpm@10.28.0"
}
