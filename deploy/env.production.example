# Salin ke server/.env.production di VPS lalu isi. JANGAN di-commit.
# DATABASE_URL, REDIS_URL, PUBLIC_WEB_URL, S3_*, TRUST_PROXY diisi otomatis oleh docker-compose.prod.yml.
# API menolak start bila ada isian berbahaya (gateway mock, secret contoh, dll.) — lihat log: docker compose ... logs api

# openssl rand -base64 48
JWT_SECRET=
SESSION_HOURS=8

SUPERADMIN_EMAIL=superadmin@masri-m.com
# Password awal (wajib diganti saat login pertama)
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=Super Admin Masri-M

# Pembayaran Indonesia (Midtrans). Mulai dengan sandbox, lalu ganti ke kunci production saat go-live.
PAYMENT_PROVIDER=midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Kurir Indonesia (Biteship). BITESHIP_WEBHOOK_TOKEN: openssl rand -hex 16
SHIPPING_PROVIDER=biteship
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=

# Malaysia & Brunei: none = belum dibuka (pembayaran di kaunter cawangan)
PAYMENT_PROVIDER_MY=none
SHIPPING_PROVIDER_MY=none
PAYMENT_PROVIDER_BN=none
# BILLPLZ_API_KEY=
# BILLPLZ_COLLECTION_ID=
# BILLPLZ_X_SIGNATURE=
# BILLPLZ_IS_PRODUCTION=false
# EASYPARCEL_API_KEY=
# EASYPARCEL_IS_PRODUCTION=false

# WhatsApp (Fonnte) — wajib: kode masuk nasabah dikirim lewat WhatsApp
WHATSAPP_PROVIDER=fonnte
FONNTE_TOKEN=

# Email
SMTP_URL=
MAIL_FROM="Masri-M Syariah <no-reply@masri-m.com>"

# Asisten Virtual (opsional)
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5

# Monitoring & alert
ALERT_WHATSAPP=
ALERT_EMAIL=
# openssl rand -hex 24
MONITOR_TOKEN=
APP_ENV_NAME=produksi
