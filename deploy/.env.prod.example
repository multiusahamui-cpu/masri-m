# Variabel docker-compose.prod.yml (salin ke .env di folder root repo pada VPS). JANGAN di-commit.
DOMAIN=masri-m.com
ACME_EMAIL=admin@masri-m.com
# Opsional: halaman status Uptime Kuma (buat DNS A record-nya juga)
STATUS_DOMAIN=status.masri-m.com
APP_VERSION=1.0.0

POSTGRES_USER=masrim
POSTGRES_DB=masrim
# openssl rand -base64 32 | tr -d '/+=' 
POSTGRES_PASSWORD=
MINIO_ROOT_USER=masrim-storage
MINIO_ROOT_PASSWORD=
# Akun MinIO khusus aplikasi (hanya bucket masrim). Disarankan diisi; bila kosong API memakai akun root.
MINIO_APP_USER=masrim-app
MINIO_APP_PASSWORD=
S3_BUCKET=masrim
# Password Redis (openssl rand -base64 24 | tr -d '/+=')
REDIS_PASSWORD=

# Cadangan
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_MONTHS=12
# Salinan off-site (disarankan): nama remote rclone + folder, mis. r2:masrim-backup
# Konfigurasi remote ada di deploy/rclone/rclone.conf (lihat docs/DEPLOY.md)
RCLONE_REMOTE=
# Kunci publik age (age-keygen di komputer Anda, BUKAN di server) untuk mengenkripsi dump off-site
BACKUP_AGE_RECIPIENT=
