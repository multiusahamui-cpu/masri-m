# Container cadangan: pg_dump harian + salinan file MinIO + uji restore mingguan + salinan off-site (rclone, opsional)
FROM postgres:17-alpine
RUN apk add --no-cache rclone tzdata bash coreutils age
COPY deploy/backup.sh deploy/restore.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/backup.sh /usr/local/bin/restore.sh
ENV TZ=Asia/Jakarta
CMD ["backup.sh", "loop"]
