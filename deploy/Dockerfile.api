# API Masri-M (Express + Drizzle). Build dari root repo: docker build -f deploy/Dockerfile.api .
FROM node:22-alpine
ARG APP_VERSION=dev
RUN corepack enable
ENV CI=true
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY server/package.json server/
RUN pnpm install --frozen-lockfile --filter masrim-server
COPY server server
RUN pnpm --filter masrim-server build \
 && rm -rf server/src server/tests \
 && pnpm install --frozen-lockfile --filter masrim-server --prod \
 && mkdir -p /app/server/uploads && chown -R node:node /app/server/uploads
WORKDIR /app/server
ENV NODE_ENV=production PORT=4000 APP_VERSION=${APP_VERSION}
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:4000/api/health || exit 1
# Migrasi & seed parameter dasar idempoten, lalu jalankan API
CMD ["sh", "-c", "node dist/db/migrate.js && node dist/db/seed.js && node dist/index.js"]
